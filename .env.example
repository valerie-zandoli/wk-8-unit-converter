# Copy to .env for local reference only — this project's frontend build reads these from
# real environment variables (e.g. set in the Vercel dashboard), not from a committed file.
# Get both values from your Supabase project: Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
